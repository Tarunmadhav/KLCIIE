# Supabase project URL, e.g. https://abcxyz.supabase.co
VITE_SUPABASE_URL=
# Supabase anon (publishable) key
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SMTP for the send-recruit-email Edge Function (recruitment emails).
# These are SERVER-SIDE ONLY. No VITE_ prefix, so Vite never exposes them to
# the browser. Push them to the Edge Function secrets with:
#
#   npx supabase login
#   npx supabase link --project-ref <your-project-ref>
#   npx supabase secrets set --env-file .env
#
# Gmail: use port 465 (SSL) with a 16-character App Password (enable 2-Step
# Verification -> Google Account -> Security -> App passwords). Port 465 is
# allowed for outbound calls from Supabase Edge Functions.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ciie@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="KL CIIE <ciie@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="KL CIIE <you@gmail.com>"