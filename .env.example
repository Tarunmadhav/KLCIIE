# Supabase project URL, e.g. https://abcxyz.supabase.co
VITE_SUPABASE_URL=
# Supabase anon (publishable) key
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SMTP for the send-recruit-email Edge Function (registration OTP emails).
#
# PRIMARY: manage up to 10 Gmail SMTP accounts in the Admin panel
# (/admin/smtp). They are stored in public.smtp_settings (super-admin,
# MFA-gated) and used for OTP sends with silent failover — account #1 is tried
# first, then #2, #3, ... and only if every configured account fails does the
# user see an error. If 1 or 2 accounts are entered, only those are used.
#
# FALLBACK (optional, legacy): these env secrets are only used by the Edge
# Function when NO accounts are configured in the admin panel. SERVER-SIDE
# ONLY — no VITE_ prefix, so Vite never exposes them to the browser. Push them
# with:
#
#   npx supabase login
#   npx supabase link --project-ref <your-project-ref>
#   npx supabase secrets set --env-file .env
#   npx supabase functions deploy send-recruit-email
#
# Gmail: use port 465 (SSL) with a 16-character App Password (enable 2-Step
# Verification -> Google Account -> Security -> App passwords). Port 465 is
# allowed for outbound calls from Supabase Edge Functions.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ciie@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="KL CIIE <ciie@gmail.com>"
